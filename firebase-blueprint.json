{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user profile with role-based access control",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "STAFF"] },
        "photoURL": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["uid", "email", "role", "active"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "brand": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "unit": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minimumStock": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "maximumStock": { "type": "number" },
        "barcode": { "type": "string" },
        "imageUrl": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["sku", "name", "categoryId", "purchasePrice", "sellingPrice", "currentStock", "reorderLevel", "active"]
    },
    "Category": {
      "title": "Category",
      "description": "Product categorization",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["name", "active"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Inventory supplier contact and details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "website": { "type": "string" },
        "notes": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["name", "active"]
    },
    "InventoryTransaction": {
      "title": "InventoryTransaction",
      "description": "Immutable historical stock movement log",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "type": { "type": "string", "enum": ["STOCK_IN", "STOCK_OUT", "ADJUSTMENT", "RETURN", "TRANSFER"] },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "sku": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "unitCost": { "type": "number" },
        "totalValue": { "type": "number" },
        "referenceNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "customerName": { "type": "string" },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["type", "productId", "quantity", "previousStock", "newStock", "createdAt"]
    },
    "StockIn": {
      "title": "StockIn",
      "description": "Multi-product stock intake transaction",
      "type": "object",
      "properties": {
        "referenceNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "date": { "type": "string" },
        "items": { "type": "array" },
        "totalCost": { "type": "number" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["referenceNumber", "items", "totalCost", "createdAt"]
    },
    "StockOut": {
      "title": "StockOut",
      "description": "Multi-product stock delivery or issuance transaction",
      "type": "object",
      "properties": {
        "referenceNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "date": { "type": "string" },
        "items": { "type": "array" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["referenceNumber", "items", "createdAt"]
    },
    "StockAdjustment": {
      "title": "StockAdjustment",
      "description": "Stock reconciliation adjustment record",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "sku": { "type": "string" },
        "systemQuantity": { "type": "number" },
        "actualQuantity": { "type": "number" },
        "difference": { "type": "number" },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["productId", "systemQuantity", "actualQuantity", "difference", "reason", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System inventory alerts and notices",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "productId": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "object" }
      },
      "required": ["type", "title", "message", "read", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Comprehensive security and operational audit trail",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "recordId": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "type": "object" },
        "createdAt": { "type": "object" }
      },
      "required": ["action", "module", "createdAt"]
    },
    "Settings": {
      "title": "Settings",
      "description": "System configuration parameters",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "businessLogo": { "type": "string" },
        "currency": { "type": "string" },
        "dateFormat": { "type": "string" },
        "defaultReorderLevel": { "type": "number" },
        "allowNegativeInventory": { "type": "boolean" },
        "lowStockAlertsEnabled": { "type": "boolean" },
        "emailAlerts": { "type": "boolean" },
        "updatedAt": { "type": "object" },
        "updatedBy": { "type": "string" }
      },
      "required": ["businessName", "currency"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles and RBAC role assignment"
    },
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "All inventory items and SKU tracking"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "Category" },
      "description": "Product categories"
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "Supplier" },
      "description": "Supplier database and contacts"
    },
    "/inventoryTransactions/{transactionId}": {
      "schema": { "$ref": "InventoryTransaction" },
      "description": "Immutable movement history records"
    },
    "/stockIn/{stockInId}": {
      "schema": { "$ref": "StockIn" },
      "description": "Stock receiving batch orders"
    },
    "/stockOut/{stockOutId}": {
      "schema": { "$ref": "StockOut" },
      "description": "Stock issuing and delivery orders"
    },
    "/stockAdjustments/{adjustmentId}": {
      "schema": { "$ref": "StockAdjustment" },
      "description": "Discrepancy adjustments and reconciliations"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "Notification" },
      "description": "Low stock and system alerts"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Administrative audit event records"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "Settings" },
      "description": "System-wide parameters (e.g., settings/general)"
    }
  }
}
